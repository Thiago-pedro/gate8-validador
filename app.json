{
  "expo": {
    "name": "Gate8 Portaria",
    "slug": "gate8-validador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gate8validador",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "backgroundColor": "#0b1730",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.gate8.validador",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera lê o QR do ingresso na portaria."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "club.gate8.validador",
      "adaptiveIcon": {
        "backgroundColor": "#050d1f",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-8.png",
          "resizeMode": "contain",
          "backgroundColor": "#050d1f",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera lê o QR do ingresso na portaria."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
